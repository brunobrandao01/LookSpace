{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LookSpace Auto Sync",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\auto-sync.ps1"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Run auto-sync to stage, commit, and push LookSpace changes to GitHub."
    }
  ]
}